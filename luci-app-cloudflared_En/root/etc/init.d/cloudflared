#!/bin/sh /etc/rc.common

START=99
PROG="$(uci -q get cloudflared.@cloudflared[0].cfbin)"
USE_PROCD=1

# get_tz: read the system timezone (/etc/localtime, or /etc/TZ, /var/etc/TZ)
# and pass it to the program via the TZ environment variable so logs follow
# the local timezone.
get_tz() {
	SET_TZ=""
	[ -e "/etc/localtime" ] && return
	for tzfile in /etc/TZ /var/etc/TZ
	do
		[ -e "$tzfile" ] || continue
		tz="$(cat $tzfile 2>/dev/null)"
	done
	[ -z "$tz" ] && return
	SET_TZ=$tz
}

start_instance() {
	local cfg="$1"
        local enabled
	config_get_bool enabled "$cfg" 'enabled' '0'
	[ "$enabled" = "1" ] || return 1
	local token loglevel custom_cmd cmdenabled update protocol region region_custom edge_ip_version retries ha_connections metrics
	config_get token "$cfg" 'token'
	config_get loglevel "$cfg" 'loglevel'
	config_get custom_cmd "$cfg" 'custom_cmd'
	config_get_bool cmdenabled "$cfg" 'cmdenabled'
	config_get_bool update "$cfg" 'update' '0'
	config_get protocol "$cfg" 'protocol'
	config_get region "$cfg" 'region'
	config_get region_custom "$cfg" 'region_custom'
	config_get edge_ip_version "$cfg" 'edge_ip_version'
	config_get retries "$cfg" 'retries'
	config_get ha_connections "$cfg" 'ha_connections'
	config_get metrics "$cfg" 'metrics'
	if [ ! -f "$PROG" ] ;then
	 uci -q set cloudflared.@cloudflared[0].enabled=0 
	 uci commit cloudflared 
	 echo "$(date -R +%Y:%m:%d\ %X) : $PROG Not found, unable to start! Please confirm that the program has been uploaded!" >>/tmp/cloudflared.info
	 echo "Download: https://github.com/cloudflare/cloudflared/releases" >>/tmp/cloudflared.info  
	 exit 1
	fi
	chmod +x $PROG
	
	if [ $(($($PROG help 2>&1 | wc -l))) -lt 3 ] ;then
	  uci -q set cloudflared.@cloudflared[0].enabled=0 
	  uci commit cloudflared 
	  echo "$(date -R +%Y:%m:%d\ %X) : $PROG Programs that are incomplete or not supported by the CPU architecture cannot be started.!" >>/tmp/cloudflared.info 
	  exit 1
	fi
	if [ "$cmdenabled" = "1" ] && [ -z "$custom_cmd" ] ;then 
	   uci -q set cloudflared.@cloudflared[0].enabled=0 
	   uci commit cloudflared 
	   echo "$(date -R +%Y:%m:%d\ %X) : Custom parameters are empty and cannot be started!" >>/tmp/cloudflared.info  
	   exit 1
	fi
	procd_open_instance cloudflared
	procd_set_param command $PROG
	procd_set_param pidfile /var/run/cloudflared.pid

	# pass the system timezone to the program via the TZ env var
	get_tz
	[ -z "$SET_TZ" ] || procd_set_param env TZ="$SET_TZ"

	if [ "$cmdenabled" = "1" ];  then
	   # Parse every custom argument: each list item may hold multiple space-separated
	   # parameters, extracted fully without truncation
	   for custom_cmd_arg in $(cat /etc/config/cloudflared | grep 'list custom_cmd' | awk '{sub(/^[[:space:]]*list[[:space:]]*custom_cmd[[:space:]]*/,""); print}' | sed "s/'/\n/g" | tr -d "'"); do
		procd_append_param command "$custom_cmd_arg"
	   done
	else 
	   if [ -z "$token" ] ;then 
	     uci -q set cloudflared.@cloudflared[0].enabled=0 
	     uci commit cloudflared 
	     echo "$(date -R +%Y:%m:%d:\ %X) : token parameter is empty!" >>/tmp/cloudflared.info  
	     exit 1
	   fi
	   procd_append_param command tunnel
	   # Auto update is disabled by default (not supported on mips processors)
	   [ "$update" = "1" ] || procd_append_param command --no-autoupdate
	   [ -n "$metrics" ] && procd_append_param command --metrics "$metrics"
	   # When "Custom" is selected for the region, use the manually typed code
	   [ "$region" = "other" ] && region="$region_custom"
	   [ -n "$region" ] && procd_append_param command --region "$region"
	   [ -n "$edge_ip_version" ] && procd_append_param command --edge-ip-version "$edge_ip_version"
	   [ -n "$protocol" ] && procd_append_param command --protocol "$protocol"
	   [ -n "$retries" ] && procd_append_param command --retries "$retries"
	   [ -n "$ha_connections" ] && procd_append_param command --ha-connections "$ha_connections"
	   if [ "$loglevel" != "off" ] ; then
		procd_append_param command --logfile /tmp/cloudflared.info
		procd_append_param command --loglevel "$loglevel"
	   fi
	   procd_append_param command run
	   procd_append_param command --token "$token"
	fi
	
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
	echo `date +%s` > /tmp/cloudflared_time
	 
}

start_service() {
	config_load 'cloudflared'
	config_foreach start_instance 'cloudflared'
}

reload_service() {
	stop
	start
}

stop_service() {
  rm -rf /tmp/cloudflared.info
  rm -rf /tmp/cloudflared.tag /tmp/cloudflarednew.tag
}

service_triggers() {
	procd_add_reload_trigger cloudflared
        procd_add_interface_trigger "interface.*.up" wan /etc/init.d/cloudflared reload
}
